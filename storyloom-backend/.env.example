# --- Server ---
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- AI provider (content generation) ---
# Set AI_PROVIDER to "anthropic" (default), "openai", or "gemini" — only ONE
# key is required, matching whichever provider you pick. Swapping providers
# needs no code changes, just these env vars.
AI_PROVIDER=anthropic

# If AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=sk-ant-xxxx

# If AI_PROVIDER=openai:
# OPENAI_API_KEY=sk-proj-xxxx

# If AI_PROVIDER=gemini (key from Google AI Studio):
# GEMINI_API_KEY=AIzaSyxxxx

# Optional override — defaults to claude-sonnet-5 (anthropic), gpt-4o (openai),
# or gemini-3.6-flash (gemini)
# AI_MODEL=gpt-4o
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.9

# --- Databricks SQL Warehouse (persistence: projects, scenes, feedback, rankings) ---
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=storyloom
DATABRICKS_SCHEMA=prod

# --- Databricks Model Serving (optional: swap in a fine-tuned/ML ranking model
#     instead of the LLM-based ranking heuristic in rankingAgent.js) ---
DATABRICKS_SERVING_ENDPOINT_URL=
DATABRICKS_SERVING_TOKEN=

# --- Regeneration behavior ---
MAX_GENERATION_HISTORY=10

# --- Auth ---
# Long random string signing session tokens — generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d

# The one Director account. Created by `npm run db:migrate` (upserted if the
# username doesn't already exist) — public signup can only create creators.
# Avoid "#" in the password value unquoted — dotenv treats it as a comment
# start and silently truncates everything after it.
DIRECTOR_USERNAME=director
DIRECTOR_PASSWORD=change-me
DIRECTOR_DISPLAY_NAME=Director
